{
    // Benchmark de génération de villages : un job "C" et un job "CUDA".
    //
    // IMPORTANT : lancer avec « Exécuter sans débogage » (Ctrl+F5). Sous le
    // débogueur, cppvsdbg ralentit fortement le processus et les deux jobs ne
    // sont plus comparables.
    //
    // Les deux jobs utilisent le MÊME binaire, compilé par le même compilateur ;
    // seul --c / --cuda change. Comparer un binaire mingw à un binaire MSVC
    // mesurerait surtout la différence entre les deux compilateurs.
    //
    // CUBIOMES_LAYER_CACHE=0 est nécessaire : le cache de layer de cubiomes
    // fausse les biomes des requêtes 1x1, les deux backends ne généreraient
    // alors pas les mêmes villages (cf. c/test_layer_cache_consistency.c).
    //
    // Chaque job affiche un checksum de toutes les pièces : s'ils sont égaux,
    // les deux ont produit exactement les mêmes villages.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Bench villages — C (CPU)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/bench_village.exe",
            "args": ["--c", "--seed", "1", "--count", "10000"],
            "cwd": "${workspaceFolder}/c/cuda",
            "environment": [
                { "name": "CUBIOMES_LAYER_CACHE", "value": "0" }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build: bench_village"
        },
        {
            "name": "Bench villages — CUDA (GPU)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/bench_village.exe",
            "args": ["--cuda", "--seed", "1", "--count", "10000"],
            "cwd": "${workspaceFolder}/c/cuda",
            "environment": [
                { "name": "CUBIOMES_LAYER_CACHE", "value": "0" }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build: bench_village"
        },
        {
            // Tourne sans fin : arrêter avec le bouton stop de VS Code.
            // La structure seed de départ est tirée au hasard et imprimée en
            // première ligne — la noter pour pouvoir rejouer la même recherche
            // avec --seed.
            // Les trouvailles vont sur la console ET dans c/cuda/village_finds.log.
            "name": "Recherche villages — CUDA (> 5 forgerons)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/search_village_cuda.exe",
            "args": [
                "--smiths", "6",
                "--pieces", "250",
                "--worlds", "32",
                "--out", "village_finds.log"
            ],
            "cwd": "${workspaceFolder}/c/cuda",
            "environment": [
                { "name": "CUBIOMES_LAYER_CACHE", "value": "0" }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build: search_village_cuda"
        },
        {
            "name": "Recherche villages — CUDA (seuil au choix)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/search_village_cuda.exe",
            "args": [
                "--smiths", "${input:seuilForgerons}",
                "--pieces", "0",
                "--worlds", "32",
                "--out", "village_finds.log"
            ],
            "cwd": "${workspaceFolder}/c/cuda",
            "environment": [
                { "name": "CUBIOMES_LAYER_CACHE", "value": "0" }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build: search_village_cuda"
        },
        {
            "name": "Bench villages — C (rapide, 500)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/bench_village.exe",
            "args": ["--c", "--seed", "1", "--count", "500"],
            "cwd": "${workspaceFolder}/c/cuda",
            "environment": [
                { "name": "CUBIOMES_LAYER_CACHE", "value": "0" }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build: bench_village"
        },
        {
            "name": "Bench villages — CUDA (rapide, 500)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/bench_village.exe",
            "args": ["--cuda", "--seed", "1", "--count", "500"],
            "cwd": "${workspaceFolder}/c/cuda",
            "environment": [
                { "name": "CUBIOMES_LAYER_CACHE", "value": "0" }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build: bench_village"
        }
    ],
    "inputs": [
        {
            "id": "seuilForgerons",
            "type": "pickString",
            "description": "Journaliser à partir de combien de forgerons ?",
            "options": ["4", "5", "6", "7", "8"],
            "default": "6"
        }
    ]
}
