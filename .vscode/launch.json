{
    // Jobs de génération / recherche de villages.
    //
    // IMPORTANT : lancer avec « Exécuter sans débogage » (Ctrl+F5). Sous le
    // débogueur, cppvsdbg ralentit fortement le processus et les mesures ne
    // sont plus comparables.
    //
    // Les jobs de bench utilisent le MÊME binaire, compilé par le même
    // compilateur ; seul --c / --cuda change. Comparer un binaire mingw à un
    // binaire MSVC mesurerait surtout la différence entre les deux compilateurs.
    //
    // Le bug du cache de layer cubiomes (collision de clé au point (-1,-1)) est
    // corrigé : CUBIOMES_LAYER_CACHE=0 n'est plus nécessaire. Vérifiable par
    // `make -C c test_layer_cache_consistency`.
    //
    // Le travail du bench est défini par un ENSEMBLE de world seeds, pas par un
    // nombre de villages : l'ensemble produit est donc identique quel que soit
    // le nombre de threads. Le checksum est commutatif — s'il est le même entre
    // deux configurations, elles ont produit exactement les mêmes villages.
    //
    // Mesuré sur RTX 5070 + Ryzen 7 9700X : l'optimum est à 16-20 threads
    // (~1850 villages/s). Le 9700X a 8 cœurs mais 16 logiques, et chaque thread
    // passe ~28 % de son temps à attendre le GPU — d'où le gain à sur-allouer.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Bench villages — CUDA (16 threads)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/bench_village.exe",
            "args": ["--cuda", "--seed", "1", "--worlds", "520", "--threads", "16"],
            "cwd": "${workspaceFolder}/c/cuda",
            "console": "integratedTerminal",
            "preLaunchTask": "build: bench_village"
        },
        {
            "name": "Bench villages — CUDA (1 thread)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/bench_village.exe",
            "args": ["--cuda", "--seed", "1", "--worlds", "520", "--threads", "1"],
            "cwd": "${workspaceFolder}/c/cuda",
            "console": "integratedTerminal",
            "preLaunchTask": "build: bench_village"
        },
        {
            "name": "Bench villages — C (16 threads)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/bench_village.exe",
            "args": ["--c", "--seed", "1", "--worlds", "520", "--threads", "16"],
            "cwd": "${workspaceFolder}/c/cuda",
            "console": "integratedTerminal",
            "preLaunchTask": "build: bench_village"
        },
        {
            "name": "Bench villages — scaling au choix",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/bench_village.exe",
            "args": ["--cuda", "--seed", "1", "--worlds", "120",
                     "--threads", "${input:nbThreads}"],
            "cwd": "${workspaceFolder}/c/cuda",
            "console": "integratedTerminal",
            "preLaunchTask": "build: bench_village"
        },
        {
            // Tourne sans fin : arrêter avec le bouton stop de VS Code.
            // La structure seed de départ est tirée au hasard et imprimée en
            // première ligne — la noter pour rejouer la même recherche (--seed).
            // Les trouvailles vont sur la console ET dans c/cuda/village_finds.log.
            "name": "Recherche villages — CUDA (> 5 forgerons, 16 threads)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/search_village_cuda.exe",
            "args": [
                "--smiths", "6",
                "--pieces", "250",
                "--worlds", "32",
                "--threads", "16",
                "--out", "village_finds.log"
            ],
            "cwd": "${workspaceFolder}/c/cuda",
            "console": "integratedTerminal",
            "preLaunchTask": "build: search_village_cuda"
        },
        {
            // Cas de régression sur des villages précis, signalés incohérents
            // avec le jeu (8 forgerons rapportés, 4 constatés).
            // Vérifie : pas de pièce en double, CPU == CUDA, et surtout aucune
            // pièce posée sur une hauteur tronquée par le plafond de scan.
            // Sort en code 1 si une anomalie est détectée.
            "name": "Test cohérence villages (seeds de référence)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/test_village_seeds.exe",
            "args": [],
            "cwd": "${workspaceFolder}/c/cuda",
            "console": "integratedTerminal",
            "preLaunchTask": "build: test_village_seeds"
        },
        {
            // Même test sur un village au choix, avec le détail de toutes les pièces.
            "name": "Test cohérence villages — worldSeed au choix",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/test_village_seeds.exe",
            "args": ["${input:worldSeed}", "${input:chunkX}", "${input:chunkZ}", "--dump"],
            "cwd": "${workspaceFolder}/c/cuda",
            "console": "integratedTerminal",
            "preLaunchTask": "build: test_village_seeds"
        },
        {
            // Reprend des structure seeds deja trouvees et balaye les 65 536
            // world seeds possibles (les 16 bits de poids fort).
            //
            // Entree : c/cuda/seeds_a_affiner.txt — une cible par ligne, au
            // format « structureSeed (chunkX,chunkZ) ». Une ligne TROUVE de la
            // recherche collee telle quelle marche aussi.
            // Sortie : c/cuda/seeds_trouvees.txt, une seed nue par ligne et rien
            // d'autre, a coller directement dans le jeu. Une ligne par cible :
            // la meilleure world seed. Le fichier est REECRIT a chaque
            // lancement. Le detail reste sur la console.
            //
            // A savoir avant de lancer : le world seed ne fait varier que le
            // TERRAIN, pas le tirage du jigsaw (ChunkRand vient de la structure
            // seed et du chunk). Mesure sur une cible : 1196 world seeds donnent
            // le meme village a 9 forgerons, et aucune ne fait mieux. L'outil
            // donne donc du CHOIX, pas de meilleurs villages.
            // Comptez ~12 s par cible.
            "name": "Affiner les seeds — 65 536 world seeds",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/refine_seeds.exe",
            "args": [
                "--in", "seeds_a_affiner.txt",
                "--out", "seeds_trouvees.txt",
                "--smiths", "8",
                "--threads", "16"
            ],
            "cwd": "${workspaceFolder}/c/cuda",
            "console": "integratedTerminal",
            "preLaunchTask": "build: refine_seeds"
        },
        {
            "name": "Recherche villages — CUDA (seuil et threads au choix)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/c/cuda/search_village_cuda.exe",
            "args": [
                "--smiths", "${input:seuilForgerons}",
                "--pieces", "0",
                "--worlds", "32",
                "--threads", "${input:nbThreads}",
                "--out", "village_finds.log"
            ],
            "cwd": "${workspaceFolder}/c/cuda",
            "console": "integratedTerminal",
            "preLaunchTask": "build: search_village_cuda"
        }
    ],
    "inputs": [
        {
            "id": "seuilForgerons",
            "type": "pickString",
            "description": "Journaliser à partir de combien de forgerons ?",
            "options": ["4", "5", "6", "7", "8"],
            "default": "6"
        },
        {
            "id": "worldSeed",
            "type": "promptString",
            "description": "worldSeed du village à vérifier",
            "default": "3735182320702388"
        },
        {
            "id": "chunkX",
            "type": "promptString",
            "description": "chunk X",
            "default": "6"
        },
        
        {
            "id": "chunkZ",
            "type": "promptString",
            "description": "chunk Z",
            "default": "23"
        },
        {
            "id": "nbThreads",
            "type": "pickString",
            "description": "Combien de threads ? (optimum mesuré : 16-20)",
            "options": ["1", "2", "4", "8", "16", "12"],
            "default": "12"
        }
    ]
}
